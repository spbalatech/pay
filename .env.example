# ---- PayPal (sandbox) — OPTIONAL to start ----
# Create at https://developer.paypal.com/dashboard/applications/sandbox
# Leave blank to develop offline: `npm run seed -- --offline` seeds a full
# history and all four agents run against it. Only live PayPal writes are off.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX

# Sandbox personal (buyer) account used by the seeder to simulate payers
PAYPAL_SANDBOX_BUYER_EMAIL=

# ---- AI provider — OPTIONAL to start ----
# auto      prefer Anthropic if a key is set, else a local Ollama if reachable
# anthropic hosted Claude
# ollama    a local model; no API key, no network
# none      disable model calls entirely
AEGIS_AI_PROVIDER=auto

# -- Option A: hosted (Anthropic) --
ANTHROPIC_API_KEY=
AEGIS_MODEL_REASONING=claude-opus-5
AEGIS_MODEL_FAST=claude-haiku-5-5

# -- Option B: local (Ollama) --
#   ollama serve && ollama pull llama3.1:8b
# Any instruct model with JSON-schema support works. Rule proposal is the
# hardest job; 4B-class models manage it, smaller ones tend to return nothing.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Optional smaller model for high-volume explanation passes.
OLLAMA_MODEL_FAST=
# Local models on CPU are slow; raise this if calls time out.
AEGIS_OLLAMA_TIMEOUT_MS=120000

# Check what is configured and do a round trip:  npm run ai:check

# ---- Webhooks ----
# Register an endpoint, then put its id here:
#   npm run webhook -- register https://<tunnel>/api/webhooks/paypal
PAYPAL_WEBHOOK_ID=
# LOCAL TESTING ONLY. PayPal's simulate-event cannot produce a genuinely
# signed event, so acting on one requires explicitly allowing unverified
# deliveries. Never set this in production. Only the literal strings "true"
# and "false" are accepted; anything else stops the app at boot.
# Left unset deliberately - the safe default is off.
# AEGIS_WEBHOOK_ALLOW_UNVERIFIED=true

# ---- Database ----
DATABASE_URL=postgresql://aegis:aegis@localhost:55439/aegis

# ---- Policy (human-set autonomy thresholds) ----
# Auto-accept disputes at or below this claim amount when EV says accept.
# DEFAULT 0 = off. PayPal's integration guidance is never to accept a claim
# without review, so this is opt-in. With it off the Advocate still assesses
# every dispute and drafts the rebuttal; a human presses the button.
AEGIS_AUTO_ACCEPT_CEILING_USD=0
# Interceptor may issue a preemptive refund up to this amount without approval
AEGIS_AUTO_REFUND_CEILING_USD=25
# Sentinel holds orders at or above this risk score (0-100)
AEGIS_HOLD_THRESHOLD=70

# ---- Optional: AG Grid Enterprise license (trial watermark is fine for the demo) ----
NEXT_PUBLIC_AG_GRID_LICENSE_KEY=
