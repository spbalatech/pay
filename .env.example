# ---- PayPal (sandbox) — OPTIONAL to start ----
# Create at https://developer.paypal.com/dashboard/applications/sandbox
# Leave blank to develop offline: `npm run seed -- --offline` seeds a full
# history and all four agents run against it. Only live PayPal writes are off.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX

# Sandbox personal (buyer) account used by the seeder to simulate payers
PAYPAL_SANDBOX_BUYER_EMAIL=

# ---- AI — OPTIONAL to start ----
# Without it, Sentinel/Interceptor/Advocate all run (their scores and expected
# values are arithmetic, not model output); only the Learner needs a model, and
# the narratives and drafted messages fall back to plain summaries.
ANTHROPIC_API_KEY=
AEGIS_MODEL_REASONING=claude-opus-5
AEGIS_MODEL_FAST=claude-haiku-5-5

# ---- Database ----
DATABASE_URL=postgresql://aegis:aegis@localhost:55439/aegis

# ---- Policy (human-set autonomy thresholds) ----
# Auto-accept disputes at or below this claim amount when EV says accept
AEGIS_AUTO_ACCEPT_CEILING_USD=35
# Interceptor may issue a preemptive refund up to this amount without approval
AEGIS_AUTO_REFUND_CEILING_USD=25
# Sentinel holds orders at or above this risk score (0-100)
AEGIS_HOLD_THRESHOLD=70

# ---- Optional: AG Grid Enterprise license (trial watermark is fine for the demo) ----
NEXT_PUBLIC_AG_GRID_LICENSE_KEY=
